# The e2e suite's environment. Committed on purpose: every value is a dummy that
# works only against the local e2e server. See docs/testing.md.
#
# Read by `wrangler dev --env-file .env.test` (tests/e2e/server.ts) and by
# tests/e2e/support/env.ts. Comments go on their own lines, never after a value:
# the two parsers disagree about inline comments.

# Signs the session cookies the tests forge. Not a secret.
BETTER_AUTH_SECRET=e2e-only-dummy-secret-0123456789abcdefghijklmnop

# The one place the e2e port is defined. Loopback only; support/env.ts refuses
# anything else. Overrides `vars.BETTER_AUTH_URL` in wrangler.jsonc.
BETTER_AUTH_URL=http://127.0.0.1:8799

# Never used: tests sign in with a forged cookie, not through GitHub.
GITHUB_CLIENT_ID=e2e-dummy-client-id
GITHUB_CLIENT_SECRET=e2e-dummy-client-secret

# Set for completeness only: BetterAuth always trusts BETTER_AUTH_URL's own origin.
TRUSTED_ORIGINS=http://127.0.0.1:8799

# A seeded admin (USERS.superadmin in tests/e2e/fixtures/seed-data.ts), so the
# superadmin refusals can be tested.
SUPERADMIN_EMAIL=superadmin@e2e.test
