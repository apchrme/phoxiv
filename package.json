{
	"name": "phoxiv",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "wrangler types ./src/worker-configuration.d.ts --check && bunx --bun vite build",
		"preview": "bun run build && wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB",
		"db:migrate-remote": "wrangler d1 migrations apply DB --remote",
		"db:studio": "drizzle-kit studio",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"db:generate-auth": "bun x auth@latest generate --config src/lib/server/auth-cli.ts"
	},
	"dependencies": {
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@leeoniya/ufuzzy": "^1.0.19",
		"@lucide/svelte": "^1.24.0",
		"@sveltejs/kit": "^2.69.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/table-core": "^8.21.3",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"csv-parse": "^7.0.2",
		"drizzle-orm": "^0.45.2",
		"gsap": "^3.15.0",
		"marked": "^18.0.6",
		"mode-watcher": "^1.1.0",
		"sanitize-html": "^2.17.6",
		"svelte": "^5.56.4",
		"svelte-seo": "^2.0.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.1",
		"@types/sanitize-html": "^2.16.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte-check": "^4.7.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.63.0",
		"vite": "8.1.4",
		"wrangler": "^4.110.0"
	}
}
