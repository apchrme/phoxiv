{
	"name": "phoxiv",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bun run build && wrangler dev",
		"deploy": "bun run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB",
		"db:migrate-remote": "wrangler d1 migrations apply DB --remote",
		"db:studio": "drizzle-kit studio",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"cf-typegen:check": "wrangler types ./src/worker-configuration.d.ts --check",
		"db:generate-auth": "bun x auth@latest generate --config src/lib/server/auth-cli.ts",
		"index:backfill": "bun run src/lib/server/reindex-cli.ts",
		"thumbs:render": "bun run src/lib/server/thumbs-cli.ts",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test --grep @smoke",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:server": "bun tests/e2e/server.ts",
		"test:e2e:report": "playwright show-report"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.12",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@leeoniya/ufuzzy": "^1.0.19",
		"@lucide/svelte": "^1.61.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/table-core": "^8.21.3",
		"better-auth": "^1.7.12",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"csv-parse": "^7.0.3",
		"drizzle-orm": "1.0.0-rc.4",
		"gsap": "^3.15.0",
		"marked": "^18.1.1",
		"mode-watcher": "^1.1.0",
		"sanitize-html": "^2.18.1",
		"svelte": "^5.57.2",
		"svelte-seo": "^2.0.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/sanitize-html": "^2.16.2",
		"devalue": "^5.9.4",
		"drizzle-kit": "1.0.0-rc.4",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.12.1",
		"eslint-plugin-svelte": "^3.23.1",
		"fflate": "^0.8.3",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"pdfjs-dist": "^6.4.299",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"unpdf": "^1.9.1",
		"vite": "^8.3.5",
		"wrangler": "^4.152.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
