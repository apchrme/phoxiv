# Copy to `.env` for local development. In production these are Worker secrets
# (`wrangler secret put <NAME>`), except BETTER_AUTH_URL, a var in wrangler.jsonc.
# Read them via `platform.env`, not `$env/*`. See docs/contributing.md.

# Random 32+ byte string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Origin BetterAuth builds its OAuth callback URLs from. http://localhost:5173 locally.
BETTER_AUTH_URL=

# GitHub OAuth app credentials. The app's callback URL must be
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated origins BetterAuth will accept requests from.
TRUSTED_ORIGINS=

# The admin who can't be demoted, banned or unbanned. Empty disables this.
SUPERADMIN_EMAIL=
