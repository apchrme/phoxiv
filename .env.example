# Copy to `.env` for local development. In production these are Cloudflare Worker
# secrets (`wrangler secret put <NAME>`) except BETTER_AUTH_URL, which is a plain
# var in wrangler.jsonc. All of them are read through `platform.env`, never
# through `$env/*`, because they have to be available per-request in the Worker.
#
# See docs/contributing.md for how to obtain each one.

# Random 32+ byte string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Origin BetterAuth builds its OAuth callback URLs from. http://localhost:5173 locally.
BETTER_AUTH_URL=

# GitHub OAuth app credentials. The app's callback URL must be
# <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated origins BetterAuth will accept requests from.
TRUSTED_ORIGINS=

# Email of the one admin that cannot be demoted, banned or unbanned from the
# admin panel. Leave empty to disable the protection.
SUPERADMIN_EMAIL=
